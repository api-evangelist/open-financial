   "paths": {
    "/v1/accounts": {
     "post": {
      "summary": "Create Virtual Account used as Collection Tool",
      "description": "Use this API to create a virtual account used as a collection tool.",
      "operationId": "accounts-virtual-collection-tool-create",
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "type",
           "used_as",
           "name",
           "mobile_number",
           "email"
          ],
          "properties": {
           "type": {
            "type": "string",
            "description": "Type of account to be created.<br><br>Accepted value: <ul><li>`virtual`</ul></li>",
            "default": "virtual"
           },
           "used_as": {
            "type": "string",
            "description": "Type of virtual account to be created.<br><br>Accepted value: <ul><li>`collection_tool`</ul></li>",
            "default": "collection_tool"
           },
           "name": {
            "type": "string",
            "description": "Applicant's name.<br><br>Maximum 70 characters.<br><br>Example: `Anil Reddy`<br><br>Supported characters:<ul><li>`A-Z`</li><li>`a-z`</li><li>`0-9`</li><li>`.`</li><li>`/`</li><li>`\\`</li><li>`-`</li><li>`_`</li><li>`,`</li><li>`(`</li><li>`)`</li><li>`'`</li></ul>"
           },
           "mobile_number": {
            "type": "string",
            "description": "Account holder's mobile number.<br><br>Has to be 10 digits.<br><br>Example: `9876543210`<br><br>Supported characters:<ul><li>`0-9`</ul></li>"
           },
           "email": {
            "type": "string",
            "description": "Account holder's email address.<br><br>Example: `anil.reddy@example.com`"
           },
           "bank_name": {
            "type": "string",
            "description": "Bank where the virtual account used as a collection tool needs to be created.<br><br>Accepted value: <ul><li>`yes_bank`</ul></li>"
           },
           "create_vpa": {
            "type": "boolean",
            "description": "Accepted values: <ul><li>`true`: Create a VPA and bank account.</li><li>`false` (default): Create bank account only.</li></ul>",
            "default": false
           },
           "kyc": {
            "type": "object",
            "description": "**Mandatory if `create_vpa` is true**.<br><br>JSON object to pass the account holder's KYC details.",
            "required": [
             "pan",
             "state_code",
             "city",
             "postal_code",
             "business_type",
             "business_category"
            ],
            "properties": {
             "pan": {
              "type": "string",
              "description": "Account holder's 10-digit PAN.<br><br>Example: `ABCDE0000Z`"
             },
             "state_code": {
              "type": "string",
              "description": "Account holder's state code according to their KYC document.<br><br>Example: `KA`<br><br>Use the <a href=\"https://developers.zwitch.io/reference/constants-state-codes\" target=\"_blank\">States API</a> to get a list of accepted values."
             },
             "city": {
              "type": "string",
              "description": "Account holder's city according to their KYC document.<br><br>Example: `bangalore`<br><br>Supported characters:<ul><li>`A-Z`</li><li>`a-z`</li><li>`0-9`</li><li>`space`</li><li>`_`</li><li>`()`</li><li>`.`</li></ul>"
             },
             "postal_code": {
              "type": "string",
              "description": "Account holder's pincode according to their KYC document.<br><br>Example: `560005`"
             },
             "business_type": {
              "type": "string",
              "description": "Business type for the virtual account.<br><br>Example: `partnership`<br><br>Use the <a href=\"https://developers.zwitch.io/reference/constants-business-types\" target=\"_blank\">Business Type API</a> to get a list of accepted values."
             },
             "business_category": {
              "type": "string",
              "description": "Business category for the virtual account.<br><br>Example: `garage_owners`<br><br>Use the <a href=\"https://developers.zwitch.io/reference/constants-business-categories\" target=\"_blank\">Business Categories API</a> to get a list of accepted values."
             },
             "contact_person": {
              "type": "string",
              "description": "Contact person's name for the business<br><br>Example: `Anil Reddy`"
             }
            }
           },
           "metadata": {
            "type": "object",
            "description": "Key-value pair that can be used to store additional information about the entity.<ul><li>Each pair cannot exceed 256 characters.</li><li>Maximum 5 key-value pairs.</li></ul>Example: `\"key_1\": \"DD”`",
            "properties": {
             "key_1": {
              "type": "string"
             },
             "key_2": {
              "type": "string"
             }
            }
           }
          }
         },
         "examples": {
          "Collection Tool": {
           "value": {
            "type": "virtual",
            "used_as": "collection_tool",
            "name": "Anil Reddy",
            "mobile_number": "9876543210",
            "email": "anil.reddy@example.com",
            "bank_name": "yes_bank",
            "create_vpa": true,
            "additional_vpa": [],
            "kyc": {
             "city": "Bangalore",
             "postal_code": "560010",
             "state_code": "KA",
             "pan": "AAAPA0000A",
             "business_type": "partnership",
             "business_category": "garage_owners",
             "pan_verification_id": "",
             "contact_person": "Rahul Reddy"
            },
            "metadata": {
             "key_1": "DD",
             "key_2": "XOF"
            }
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Collection Tool": {
            "value": "{\n    \"id\": \"va_gsXD5cMqH8XyrfTe3HelnFe43\",\n    \"object\": \"account.virtual\",\n    \"type\": \"virtual\",\n    \"used_as\": \"collection_tool\",\n    \"bank_name\": \"yes_bank\",\n    \"name\": \"Lush Adobe\",\n    \"mobile_number\": \"9876543210\",\n    \"email\": \"anil.reddy@example.com\",\n    \"account_number\": \"3636365909131910\",\n    \"ifsc_code\": \"YESB0CMSNOC\",\n    \"vpa\": \"zwch1688454450@yesbank\",\n    \"additional_vpa\": [],\n    \"whitelisted_remitters\": [],\n    \"whitelisted_beneficiaries\": [],\n    \"kyc\": {\n        \"city\": \"Bangalore\",\n        \"postal_code\": \"560010\",\n        \"state_code\": \"KA\",\n        \"pan\": \"XXXXXX905H\",\n        \"business_type\": \"partnership\",\n        \"business_category\": \"garage_owners\",\n        \"contact_person\": \"Rahul Reddy\",\n        \"pan_verification_id\": null\n    },\n    \"customer\": {\n        \"id\": \"cus_LuCej8PYu2A3AXD2VSsRFqNob\",\n        \"mobile_number\": \"9876543210\"\n    },\n    \"metadata\": {\n        \"key_1\": \"DD\",\n        \"key_2\": \"XOF\"\n    },\n    \"kyc_url\": null,\n    \"status\": \"active\",\n    \"created_at\": 1758100959,\n    \"is_sandbox\": false,\n    \"settlement_account_id\": null,\n    \"verified_beneficiaries\": [],\n    \"verified_remitters\": []\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "id": {
             "type": "string",
             "example": "va_gsXD5cMqH8XyrfTe3HelnFe43"
            },
            "object": {
             "type": "string",
             "example": "account.virtual"
            },
            "type": {
             "type": "string",
             "example": "virtual"
            },
            "used_as": {
             "type": "string",
             "example": "collection_tool"
            },
            "bank_name": {
             "type": "string",
             "example": "yes_bank"
            },
            "name": {
             "type": "string",
             "example": "Lush Adobe"
            },
            "mobile_number": {
             "type": "string",
             "example": "9876543210"
            },
            "email": {
             "type": "string",
             "example": "anil.reddy@example.com"
            },
            "account_number": {
             "type": "string",
             "example": "3636365909131910"
            },
            "ifsc_code": {
             "type": "string",
             "example": "YESB0CMSNOC"
            },
            "vpa": {
             "type": "string",
             "example": "zwch1688454450@yesbank"
            },
            "additional_vpa": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {}
             }
            },
            "whitelisted_remitters": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {}
             }
            },
            "whitelisted_beneficiaries": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {}
             }
            },
            "kyc": {
             "type": "object",
             "properties": {
              "city": {
               "type": "string",
               "example": "Bangalore"
              },
              "postal_code": {
               "type": "string",
               "example": "560010"
              },
              "state_code": {
               "type": "string",
               "example": "KA"
              },
              "pan": {
               "type": "string",
               "example": "XXXXXX905H"
              },
              "business_type": {
               "type": "string",
               "example": "partnership"
              },
              "business_category": {
               "type": "string",
               "example": "garage_owners"
              },
              "contact_person": {
               "type": "string",
               "example": "Rahul Reddy"
              },
              "pan_verification_id": {}
             }
            },
            "customer": {
             "type": "object",
             "properties": {
              "id": {
               "type": "string",
               "example": "cus_LuCej8PYu2A3AXD2VSsRFqNob"
              },
              "mobile_number": {
               "type": "string",
               "example": "9876543210"
              }
             }
            },
            "metadata": {
             "type": "object",
             "properties": {
              "key_1": {
               "type": "string",
               "example": "DD"
              },
              "key_2": {
               "type": "string",
               "example": "XOF"
              }
             }
            },
            "kyc_url": {},
            "status": {
             "type": "string",
             "example": "active"
            },
            "created_at": {
             "type": "integer",
             "example": 1758100959,
             "default": 0
            },
            "is_sandbox": {
             "type": "boolean",
             "example": false,
             "default": true
            },
            "settlement_account_id": {},
            "verified_beneficiaries": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {}
             }
            },
            "verified_remitters": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {}
             }
            }
           }
          }
         }
        }
       },
       "401": {
        "description": "401",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n  \"error\": {\n    \"type\": \"authentication_error\",\n    \"message\": \"Invalid secret key.\"\n  }\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "error": {
             "type": "object",
             "properties": {
              "type": {
               "type": "string",
               "example": "authentication_error"
              },
              "message": {
               "type": "string",
               "example": "Invalid secret key."
              }
             }
            }
           }
          }
         }
        }
       },
       "422": {
        "description": "422",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n  \"error\": {\n    \"type\": \"invalid_request_error\",\n    \"code\": \"parameter_missing\",\n    \"message\": \"The pan field is required\",\n    \"param\": \"kyc.pan\"\n  }\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "error": {
             "type": "object",
             "properties": {
              "type": {
               "type": "string",
               "example": "invalid_request_error"
              },
              "code": {
               "type": "string",
               "example": "parameter_missing"
              },
              "message": {
               "type": "string",
               "example": "The pan field is required"
              },
              "param": {
               "type": "string",
               "example": "kyc.pan"
              }
             }
            }
           }
          }
         }
        }
       }
      },
      "deprecated": false
     }
    }
   },
